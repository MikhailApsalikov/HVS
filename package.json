{
  "name": "hunters-versus-spiders",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check.mjs",
    "mobile:assets": "node scripts/mobile-assets.mjs",
    "mobile:typecheck": "pnpm --filter @hvs/mobile typecheck",
    "mobile:start": "pnpm mobile:assets && pnpm --filter @hvs/mobile start",
    "mobile:bundle": "pnpm mobile:assets && pnpm --filter @hvs/mobile bundle",
    "mobile:apk": "powershell -ExecutionPolicy Bypass -File scripts/android-build.ps1 -Variant preview",
    "mobile:aab": "powershell -ExecutionPolicy Bypass -File scripts/android-build.ps1 -Variant release"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "5.0.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
